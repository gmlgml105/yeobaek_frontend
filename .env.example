# 이 파일을 복사해 .env.local 로 만들고 값을 채운다 (.env.local 은 git 에 올라가지 않음)
# 값을 바꾸면 Vite 개발 서버(npm run dev)를 재시작해야 적용된다.

# 구글 Maps JavaScript API 브라우저 키 (해외 지도)
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보
# 반드시 "애플리케이션 제한사항 > 웹사이트"에 http://localhost:5173/* 와 배포 주소를 등록할 것
VITE_GOOGLE_MAPS_API_KEY=

# 구글 Map ID (선택). 있으면 최신 마커(AdvancedMarker)로 공통 마커 디자인을 쓴다
# Google Cloud Console > Google Maps Platform > 지도 관리 > 지도 ID 만들기 (JavaScript · 벡터)
VITE_GOOGLE_MAP_ID=

# 카카오 JavaScript 키 (한국 지도). 카카오 로그인에 쓰는 같은 카카오 개발자 앱의 "JavaScript 키"
# Kakao Developers > 내 애플리케이션 > 앱 설정 > 플랫폼 > Web 에 http://localhost:5173 등록 필수
# (REST API 키가 아님. REST 키는 경로 계산용으로 백엔드에만 둔다)
VITE_KAKAO_MAP_KEY=
